# 死类型清理器的备份文件
src-ui/src/api/types.ts.bak

# 构建产物
src-api/dist/
src-ui/dist/

# 本地运行数据（SQLite）
src-api/data/
*.db
*.db-wal
*.db-shm

# Tauri 侧车二进制（由 scripts/prepare-bin.sh 生成）
binaries/

# Tauri 生成物
src-tauri/target/
src-tauri/gen/

# 编辑器/系统
.DS_Store
.idea/
.vscode/

# 本地日志
*.log

# 重构契约快照（本地回归证据，不入库）
.refactor-baseline/

# WorkBuddy 内部工作记忆（agent 专用，非项目源码）
.workbuddy/
