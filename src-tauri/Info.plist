<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 浏览器剪藏深链：lectoforge://capture?url=&title=&text= 拉起应用并预填速记弹窗 -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.lectoforge.desktop</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>lectoforge</string>
      </array>
  <key>CFBundleURLRole</key>
  <string>Editor</string>
    </dict>
  </array>
  <!-- 拍照 / 扫描：webview 通过 getUserMedia({video}) 调用前置摄像头 -->
  <key>NSCameraUsageDescription</key>
  <string>需要访问摄像头以拍摄照片或扫描文档</string>
  <!-- 离线语音转文字：通过 getUserMedia({audio}) 录制麦克风音频 -->
  <key>NSMicrophoneUsageDescription</key>
  <string>需要访问麦克风以录制语音并离线转为文字</string>
</dict>
</plist>
