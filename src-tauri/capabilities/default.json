{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "学习工作台桌面应用默认权限",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:8787", "http://localhost:8787"]
  },
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "shell:allow-execute",
    "shell:allow-spawn",
    "notification:default",
    "updater:default",
    "dialog:default",
    "allow-update-tray-title",
    "allow-trigger-notification",
    "allow-restart-sidecar",
    "allow-select-directory",
    "allow-check-for-update",
    "allow-open-external-url",
    "allow-quit-app",
    "allow-take-pending-deep-link"
  ]
}
